/* ============================================================
   FIRESTORE SECURITY RULES — Moswada
   ------------------------------------------------------------
   هذا الملف نسخة موثّقة من القواعد المنشورة على Firebase Console
   → Firestore Database → Rules. لا يُطبَّق تلقائياً بمجرد رفعه؛ إما
   تنسخه وتلصقه في الكونسول، أو `firebase deploy --only firestore:rules`.

   تعديلات هذه النسخة:
   - isVerified(): كل كتابة/قراءة على بيانات المستخدم تتطلب بريداً موثّقاً
     (request.auth.token.email_verified)، فلا يمكن لحساب غير موثّق
     تجاوز شاشة التحقق في الواجهة بالتعامل مباشرة مع Firestore.
     حسابات Google موثّقة تلقائياً.
   - bannedEmails: أصبحت get فقط (يلزم لفحص الحظر قبل تسجيل الدخول)،
     ومنعنا list حتى لا يستطيع أحد جلب قائمة المحظورين كاملة.

   isAdmin():
     - القيمة "true" في isAdmin() مكان بريد الأدمن عمداً في هذا الملف
       (لإخفاء البريد). القاعدة المنشورة فعلياً في الكونسول يجب أن
       تحمل البريد الحقيقي المطابق لـ ADMIN_EMAIL في firebase-config.js.
   ============================================================ */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* حساب الأدمن الوحيد — يطابق ADMIN_EMAIL في firebase-config.js */
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == "true";
    }

    /* البريد موثّق (Google = موثّق دائماً، البريد/كلمة المرور بعد الضغط
       على رابط التحقق). ملاحظة: الـ token يتحدّث بعد getIdToken(true). */
    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    /* المحظور = uid أو بريد مسجّل في إحدى قائمتي الحظر */
    function isBanned() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/bannedUsers/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/bannedEmails/$(request.auth.token.email))
      );
    }

    /* مستخدم مسموح له: صاحب الحساب + موثّق + غير محظور */
    function isActiveOwner(userId) {
      return request.auth != null
          && request.auth.uid == userId
          && isVerified()
          && !isBanned();
    }

    match /downloads/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read, delete: if isActiveOwner(userId);

      allow create, update: if isActiveOwner(userId)
        && (!('linksCount' in request.resource.data) ||
            (request.resource.data.linksCount is int && request.resource.data.linksCount >= 0));

      match /folders/{document=**} {
        allow read, write: if isActiveOwner(userId);
      }

      match /links/{linkId} {
        allow read, update, delete: if isActiveOwner(userId);

        // حد الـ 200 رابط
        allow create: if isActiveOwner(userId) && (
          (!exists(/databases/$(database)/documents/users/$(userId)) &&
            getAfter(/databases/$(database)/documents/users/$(userId)).data.linksCount == 1)
          ||
          (exists(/databases/$(database)/documents/users/$(userId)) &&
            getAfter(/databases/$(database)/documents/users/$(userId)).data.linksCount ==
              get(/databases/$(database)/documents/users/$(userId)).data.linksCount + 1)
        ) && getAfter(/databases/$(database)/documents/users/$(userId)).data.linksCount <= 200;
      }

      // بيانات لعبة "بطاقات تعليمية" — خاصة بصاحب الحساب فقط
      match /flashcardSubjects/{document=**} {
        allow read, write: if isActiveOwner(userId);
      }
      match /flashcardFolders/{document=**} {
        allow read, write: if isActiveOwner(userId);
      }
      match /flashcards/{document=**} {
        allow read, write: if isActiveOwner(userId);
      }
    }

    /* المجلد المشارَك يبقى متاحاً حتى يصل عدد البلاغات إلى 3 (REPORTS_TO_DISABLE
       في share.js و admin-reports.js). بلاغ قديم بلا حقل count يُعامل كأنه
       وصل للحد (يبقى معطّلاً كما كان). */
    function isShareVisible(shareId) {
      return !exists(/databases/$(database)/documents/reports/$(shareId))
          || get(/databases/$(database)/documents/reports/$(shareId)).data.get('count', 3) < 3;
    }

    match /sharedFolders/{shareId} {
      allow read: if isShareVisible(shareId);
      allow create: if request.auth != null
                    && isVerified()
                    && request.auth.uid == request.resource.data.ownerUid
                    && !isBanned();
      allow update, delete: if request.auth != null
                            && isVerified()
                            && request.auth.uid == resource.data.ownerUid
                            && !isBanned();

      match /links/{linkId} {
        allow read: if isShareVisible(shareId);
        allow write: if request.auth != null
                     && isVerified()
                     && request.auth.uid ==
                        get(/databases/$(database)/documents/sharedFolders/$(shareId)).data.ownerUid
                     && !isBanned();
      }
    }

    /* البلاغات: reports/{shareId} يحمل عدّاد count، و
       reports/{shareId}/reporters/{uid} سجل لكل مُبلِّغ (إنشاء فقط، فلا
       يستطيع الحساب نفسه التبليغ مرتين). التبليغ يتطلب حساباً موثّقاً،
       ويتم في معاملة واحدة تزيد العدّاد 1 وتنشئ سجل المُبلِّغ. */
    match /reports/{shareId} {
      allow read, delete: if isAdmin();

      // أول بلاغ: count == 1 مع سجل المُبلِّغ في نفس العملية
      allow create: if request.auth != null
                    && isVerified()
                    && !isBanned()
                    && request.resource.data.keys().hasOnly(
                         ['shareId', 'folderId', 'ownerUid', 'folderName', 'status', 'createdAt', 'count'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.count == 1
                    && request.resource.data.shareId == shareId
                    && request.resource.data.ownerUid ==
                       get(/databases/$(database)/documents/sharedFolders/$(shareId)).data.ownerUid
                    && existsAfter(/databases/$(database)/documents/reports/$(shareId)/reporters/$(request.auth.uid));

      // الأدمن يعدّل الحالة، وأي مُبلِّغ موثّق يزيد count بمقدار 1 فقط
      allow update: if isAdmin()
                    || (request.auth != null
                        && isVerified()
                        && !isBanned()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
                        && request.resource.data.count == resource.data.get('count', 3) + 1
                        && existsAfter(/databases/$(database)/documents/reports/$(shareId)/reporters/$(request.auth.uid)));

      match /reporters/{reporterUid} {
        // create فقط: إعادة التبليغ من نفس الحساب تكون update فتُرفض
        allow create: if request.auth != null
                      && isVerified()
                      && request.auth.uid == reporterUid;
        allow read, delete: if isAdmin();
      }
    }

    // الحظر بالـ UID: المستخدم يقرأ سجله هو فقط، والأدمن وحده يكتب ويعرض القائمة
    match /bannedUsers/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list, write: if isAdmin();
    }

    // الحظر بالبريد (قديم). get فقط: auth.js يفحص وثيقة بريد بعينه قبل تسجيل
    // الدخول، لكن لا أحد غير الأدمن يستطيع سرد القائمة كاملة.
    match /bannedEmails/{email} {
      allow get: if true;
      allow list, write: if isAdmin();
    }
  }
}
