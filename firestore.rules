/* ============================================================
   FIRESTORE SECURITY RULES — Moswada
   ------------------------------------------------------------
   هذا الملف نسخة موثّقة (نفس القواعد المنشورة حالياً على
   Firebase Console → Firestore Database → Rules) عشان تبقى
   محفوظة في الكود وتحت git، مش بس في الكونسول.

   ⚠️ هذا الملف لا يُطبَّق تلقائياً بمجرد رفعه على GitHub. لازم
   واحد من الاثنين:
     أ) تنسخ محتواه وتلصقه يدوياً في Firebase Console → Firestore
        Database → Rules → Publish (زي ما بتعمل دلوقتي).
     ب) أو تستخدم Firebase CLI: `firebase deploy --only firestore:rules`
        (المشروع فيه firebase.json بيشاور على الملف ده).

   isAdmin():
     - بريد الأدمن مكتوب مرة واحدة فقط داخل الدالة isAdmin()
       بالأسفل، وباقي القواعد تستدعيها. لازم يطابق ADMIN_EMAIL في
       firebase-config.js بالظبط. لو غيّرت بريد الأدمن، حدّثه في
       المكانين (هنا وفي الكونسول).

   downloads/{docId}:
     - القراءة مفتوحة للجميع (صفحة التنزيلات عامة).
     - الكتابة مسموحة فقط للأدمن.

   users/{userId}/**:
     - كل مستخدم يقرأ/يكتب بياناته الخاصة فقط (folders/links)،
       ما لم يكن محظوراً (isBanned).
     - إنشاء رابط جديد يتطلب زيادة users/{uid}.linksCount بمقدار 1
       بالظبط في نفس العملية، وألا يتجاوز 200.

   sharedFolders/{shareId} (+ /links/{linkId}):
     - القراءة مفتوحة للجميع (رابط المشاركة العام في share.html)
       طالما لا يوجد بلاغ على هذا المجلد.
     - الإنشاء: أي مستخدم مسجّل دخول، بشرط أن يكتب uid نفسه كمالك
       (ownerUid == request.auth.uid) — يمنع انتحال ملكية مجلد.
     - التعديل/الحذف: فقط صاحب المجلد الأصلي (owner).

   reports/{shareId}:
     - أي زائر يقدر يبلّغ (create) لكن مرة واحدة فقط لكل مجلد
       (معرّف المستند = shareId). البلاغ لازم يحمل ownerUid المطابق
       لمالك المجلد الحقيقي، حتى لا يقدر أحد يلفّق بلاغاً ضد غيره.
     - القراءة/التعديل/الحذف: للأدمن فقط.

   الحظر:
     - bannedUsers/{uid}   ← الأساسي. الأدمن يحظر بالـ UID لأنه
                              موجود في كل بلاغ (ownerUid).
     - bannedEmails/{email} ← يبقى للتوافق مع أي حظر قديم بالبريد.
     - isBanned() يفحص الاثنين، فأي حساب في أي قائمة يُمنع من
       الكتابة على بياناته وعلى المجلدات المشاركة.
   ============================================================ */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* حساب الأدمن الوحيد — يطابق ADMIN_EMAIL في firebase-config.js */
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == "ziadbasha099@gmail.com";
    }

    /* المحظور = uid أو بريد مسجّل في إحدى قائمتي الحظر */
    function isBanned() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/bannedUsers/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/bannedEmails/$(request.auth.token.email))
      );
    }

    match /downloads/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- قسم المستخدمين مع الحفاظ على حظر الحسابات وحد الـ 200 رابط ---
    match /users/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId && !isBanned();

      allow create, update: if request.auth != null && request.auth.uid == userId && !isBanned()
        && (!('linksCount' in request.resource.data) ||
            (request.resource.data.linksCount is int && request.resource.data.linksCount >= 0));

      match /folders/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId && !isBanned();
      }

      match /links/{linkId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == userId && !isBanned();

        // إرجاع ميزة حد الـ 200 رابط المفقودة
        allow create: if request.auth != null && request.auth.uid == userId && !isBanned() && (
          (!exists(/databases/$(database)/documents/users/$(userId)) &&
            getAfter(/databases/$(database)/documents/users/$(userId)).data.linksCount == 1)
          ||
          (exists(/databases/$(database)/documents/users/$(userId)) &&
            getAfter(/databases/$(database)/documents/users/$(userId)).data.linksCount ==
              get(/databases/$(database)/documents/users/$(userId)).data.linksCount + 1)
        ) && getAfter(/databases/$(database)/documents/users/$(userId)).data.linksCount <= 200;
      }

      // لا توجد قاعدة شاملة {document=**} هنا عمداً: كانت تطابق أيضاً
      // users/{uid}/links/** وتتجاوز شرط حد الـ 200 أعلاه. المسارات المسموحة
      // تحت users/{uid} هي فقط: مستند المستخدم نفسه، folders، links.
      // أي إنشاء لرابط لازم يمر عبر createLinkWithCounter() (links-counter.js).
    }

    // --- قسم المجلدات المشاركة والإبلاغات والحظر ---
    match /sharedFolders/{shareId} {
      allow read: if !exists(/databases/$(database)/documents/reports/$(shareId));
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerUid
                    && !isBanned();
      allow update, delete: if request.auth != null
                            && request.auth.uid == resource.data.ownerUid
                            && !isBanned();

      match /links/{linkId} {
        allow read: if !exists(/databases/$(database)/documents/reports/$(shareId));
        allow write: if request.auth != null
                     && request.auth.uid ==
                        get(/databases/$(database)/documents/sharedFolders/$(shareId)).data.ownerUid
                     && !isBanned();
      }
    }

    match /reports/{shareId} {
      allow read, update, delete: if isAdmin();

      // الحقول المسموحة = بالظبط ما يكتبه submitReport() في share.js،
      // و ownerUid لازم يطابق مالك المجلد المشارَك الحقيقي.
      allow create: if request.resource.data.keys().hasOnly(
                         ['shareId', 'folderId', 'ownerUid', 'folderName', 'status', 'createdAt'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.shareId == shareId
                    && request.resource.data.ownerUid ==
                       get(/databases/$(database)/documents/sharedFolders/$(shareId)).data.ownerUid;
    }

    // الحظر بالـ UID (الأساسي): المستخدم يقرأ سجله هو فقط (لفحص auth.js
    // بعد تسجيل الدخول)، والأدمن وحده يكتب ويعرض القائمة كاملة.
    match /bannedUsers/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list, write: if isAdmin();
    }

    // الحظر بالبريد (قديم — للتوافق فقط)
    match /bannedEmails/{email} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
